# Turso Database
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Resend Email
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=contas@yourdomain.com

# Auth
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# Admin user (single user setup)
ADMIN_EMAIL=seu@email.com

# Leitura de cupom por imagem (cartões alimentação) — provedor de visão GENÉRICO.
# Aponte para QUALQUER API compatível com OpenAI que tenha um modelo de visão.
#
# Opção A — OpenRouter (vários modelos de visão :free). Chave: https://openrouter.ai/keys
#   VISION_FALLBACK_URL=https://openrouter.ai/api/v1/chat/completions
#   VISION_FALLBACK_KEY=sk-or-...
#   VISION_FALLBACK_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free
#   (modelos de visão gratuitos: https://openrouter.ai/models?modality=text%2Bimage&max_price=0)
#
# Opção B — Mistral (Pixtral, free tier). Chave: https://console.mistral.ai
#   VISION_FALLBACK_URL=https://api.mistral.ai/v1/chat/completions
#   VISION_FALLBACK_KEY=...
#   VISION_FALLBACK_MODEL=pixtral-12b-2409
#
# VISION_FALLBACK_LABEL e VISION_FALLBACK_JSON=true são opcionais.
VISION_FALLBACK_URL=
VISION_FALLBACK_KEY=
VISION_FALLBACK_MODEL=

# v3 / Fase 2 — Open Finance via MeuPluggy (https://dashboard.pluggy.ai → aplicação de desenvolvimento)
# Só no servidor (env da Vercel). No banco fica apenas o itemId de cada conexão.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# PLUGGY_API_URL=https://api.pluggy.ai

# v3 / Fase 3 — Insights com Gemini (chave do Google AI Studio; a assinatura do app Gemini não inclui a API)
# Recebe só fatos agregados (sem descrição de transação nem nome de banco). Sem chave, o e-mail usa as frases-modelo.
GEMINI_API_KEY=
# Use um modelo Flash do tier gratuito; confira o nome atual em https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
